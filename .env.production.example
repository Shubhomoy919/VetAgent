# VetAgentBench-IN — production environment. Copy to .env.production (gitignored) for docker compose, or set
# each variable in your host's dashboard (Render / Railway / Fly). Never commit real values.
# Variables marked REQUIRED have no safe default for a public deployment.

# ---------- deployment ----------
# production: read-only public site, demo runs refused and hidden, API docs off, secure cookies, HSTS.
APP_ENV=production
# Port the server listens on. Render/Railway set PORT themselves; Fly uses internal_port from fly.toml.
PORT=8000
# Writable persistent volume: cases.json, drug_table.csv, runs.db, backups/, SVTG index cache.
DATA_DIR=/data
# Exact origin(s) of the deployed site, comma-separated, no trailing slash. REQUIRED.
# Used for CORS and to refuse cross-origin writes. Example: https://vetagentbench.example.org
ALLOWED_ORIGINS=https://your-domain.example
# Trust X-Forwarded-For from the platform proxy (correct on Render/Railway/Fly). Set to the proxy IP if you
# expose the container directly.
FORWARDED_ALLOW_IPS=*

# ---------- access control ----------
# Access code that unlocks runs, editing, Review and Settings. REQUIRED to unlock anything; leave empty for a
# permanently read-only site. Use 16+ random characters and share it only with the study team.
ADMIN_ACCESS_CODE=
# Key that signs session cookies. REQUIRED. 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it (or the access code) signs everyone out.
SESSION_SECRET=
# How long an unlocked session lasts, in hours.
SESSION_HOURS=12
# Wrong codes allowed per IP before a lockout, and the lockout length in minutes.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ---------- API budget protection ----------
# Requests per minute per client IP, on every endpoint except /api/health.
RATE_LIMIT_PER_MINUTE=240
# Hard cap on live-model tokens (input + output) per UTC day. Runs stop when it is reached and new runs are
# refused until midnight UTC. A full benchmark run (29 cases × 5 conditions) uses roughly 0.5–0.7 M tokens.
MAX_DAILY_TOKENS=1000000
# Maximum cases in one run (the full benchmark has 29).
MAX_CASES_PER_RUN=30
# Largest accepted request body in bytes (imports, edits).
MAX_BODY_BYTES=2000000

# ---------- model provider ----------
# gemini | openai_compatible. With no key, runs are disabled in production (no demo output is ever shown).
LLM_PROVIDER=gemini
# Server-side only; never sent to the browser. REQUIRED for live runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# For an OpenAI-compatible endpoint instead:
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Agent settings (also editable on the Settings page once unlocked).
TEMPERATURE=0
MAX_STEPS=6
MAX_OWNER_QUESTIONS=5
# Optional, USD per million tokens from your provider's price page; empty = cost shown as unknown.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# ---------- SVTG guidelines PDF (never served to visitors) ----------
# Where the PDF is on the server. "data/..." resolves inside DATA_DIR.
SVTG_PDF_PATH=data/StandardVeterinaryTreatment.pdf
# Optional: download DAHD's official copy to SVTG_PDF_PATH on first start if the file is missing.
SVTG_PDF_URL=https://dahd.gov.in/sites/default/files/2024-10/StandardVeterinaryTreatment.pdf

# ---------- frozen results ----------
# The v1.0.0 snapshot (a complete live run) is loaded into an empty database at startup, so the public site
# shows real numbers without spending credits. Set to false to start with an empty database.
AUTOLOAD_SNAPSHOT=true
SNAPSHOT_PATH=snapshots/v1.0.0/run.json

# ---------- server ----------
# Seconds gunicorn waits for in-flight requests (and an active run to record its status) on shutdown.
GRACEFUL_TIMEOUT=25
LOG_LEVEL=info
