# Copy to .env and fill in. .env is gitignored — never commit keys.
# With no key, the app runs in demo mode (sample responses, not live model output).

# gemini | openai_compatible | demo
LLM_PROVIDER=demo

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Local copy of the SVTG PDF, read only by the seed script (python -m app.scripts.seed). Never deployed.
SVTG_PDF_PATH=data/StandardVeterinaryTreatment.pdf

# Database. Empty = local SQLite file data/vetagentbench.db (created and seeded on first start).
# To work against Postgres (e.g. a Neon branch): set both; run migrations and the seed (docs/DEPLOY.md, step 5).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Agent settings
TEMPERATURE=0
MAX_STEPS=6
MAX_OWNER_QUESTIONS=5
# Demo mode only: milliseconds to pause per simulated model call, so streamed steps are visible. 0 = instant.
DEMO_DELAY_MS=0

# Optional: USD per million tokens, from your provider's price page. Empty = cost shown as unknown.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
