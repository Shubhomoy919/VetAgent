# Vercel environment variables for VetAgentBench-IN (Project → Settings → Environment Variables).
# Every value here is read only by the Python function on the server. Never prefix any of them with VITE_:
# Vite copies VITE_ variables into the public JavaScript bundle. This file lists names only; never commit values.
# Step-by-step guide: docs/DEPLOY.md.

# ---- Required ----
APP_ENV=production
# Added for you by the Neon (Vercel Marketplace) integration: pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Access code for runs, edits, Review and Settings. Leave empty for a permanently read-only site.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_ACCESS_CODE=
# Signs the session cookie (32+ random characters). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Your site's origin(s), comma-separated, e.g. https://vetagent.vercel.app
ALLOWED_ORIGINS=

# ---- Live model (optional: without a key, runs are disabled and only stored results show) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# The model of the frozen v1.0.0 results; re-running those cases with it is answered from the cache.
GEMINI_MODEL=gemini-3.5-flash-lite
# Any OpenAI-compatible endpoint instead (LLM_PROVIDER=openai_compatible)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Limits ----
# Live-model tokens (in + out) per UTC day across all runs. A full 29 x 5 run uses about 0.55 M.
MAX_DAILY_TOKENS=1000000
MAX_CASES_PER_RUN=30
RATE_LIMIT_PER_MINUTE=240
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
SESSION_HOURS=12
# Request bodies; Vercel's own limit is 4.5 MB.
MAX_BODY_BYTES=2000000
# One step (one case through one condition) per request; must stay below maxDuration (300 s on Hobby).
STEP_DEADLINE_S=240
# A run with no new result for this long (closed browser) is marked interrupted.
RUN_STALE_S=600

# ---- Agent ----
TEMPERATURE=0
MAX_STEPS=6
MAX_OWNER_QUESTIONS=5
# USD per million tokens, from the provider's price page; empty = cost shown as unknown.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
