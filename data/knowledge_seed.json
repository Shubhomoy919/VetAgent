  "red_flags": [
    {"id": "recumbent", "label": "down / unable to rise", "pattern": "unable to rise|cannot (get|stand) up|will not get up|won't get up|recumben", "min_triage": "emergency"},
    {"id": "resp_distress", "label": "severe breathing difficulty", "pattern": "open[- ]mouth(ed)? breathing|severe dyspn|breathing hard|respiratory distress|gasping|laboured breathing|labored breathing", "min_triage": "emergency"},
    {"id": "neuro", "label": "convulsions / nervous signs", "pattern": "convuls|seizure|opisthotonus|\\bfits\\b|torticollis|twisted necks?|head pressing|star[- ]gazing", "min_triage": "emergency"},
    {"id": "tremor", "label": "tremors or twitching", "pattern": "tremor|twitching|shaking", "min_triage": "emergency"},
    {"id": "no_urine", "label": "cannot pass urine", "pattern": "no urine|nothing comes out|only a few drops|unable to urinate|straining to (pass )?urin", "min_triage": "emergency"},
    {"id": "deaths", "label": "sudden death / deaths in group", "pattern": "sudden(ly)? death|died suddenly|died .{0,20}overnight|found dead|dying fast|dying one after|have died|died this week|died in", "min_triage": "emergency"},
    {"id": "unclotted_blood", "label": "unclotted blood from orifices", "pattern": "unclotted blood|not clotting|blood .{0,30}(nose|orifices|back passage)", "min_triage": "emergency"},
    {"id": "bite", "label": "animal bit a person", "pattern": "\\bbit (my|the|a|our|his|her)\\b|\\bbitten\\b", "min_triage": "emergency"},
    {"id": "toxic_ingestion", "label": "ate something toxic", "pattern": "(ate|eaten|swallowed|chewed).{0,60}(gum|xylitol|raisin|grape|kishmish|chocolate|rat poison)", "min_triage": "emergency"},
    {"id": "throat_swelling", "label": "throat / brisket swelling", "pattern": "throat .{0,40}swollen|swollen .{0,20}throat|brisket", "min_triage": "emergency"},
    {"id": "bloat", "label": "rapid abdominal distension", "pattern": "blown up|like a drum|bloat", "min_triage": "emergency"},
    {"id": "abortion", "label": "abortion", "pattern": "abort|threw (her|the) calf", "min_triage": "urgent"},
    {"id": "blood_in_droppings", "label": "blood in droppings or urine", "pattern": "blood in (the )?(droppings|dung|stool|urine)|bloody (droppings|diarrh)", "min_triage": "urgent"},
    {"id": "vesicles", "label": "blisters / heavy drooling", "pattern": "blisters|ropes of saliva|saliva .{0,10}dripping|drooling", "min_triage": "urgent"}
