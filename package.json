{
  "name": "vetagentbench-in",
  "private": true,
  "version": "0.1.0",
  "description": "VetAgentBench-IN â€” research prototype, not for clinical use.",
  "scripts": {
    "setup": "python -m venv .venv && .venv\\Scripts\\python.exe -m pip install -r backend/requirements-dev.txt && npm install && npm --prefix frontend install",
    "dev": "concurrently -k -n api,web -c blue,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8010",
    "dev:api:watch": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --reload --reload-dir backend --host 127.0.0.1 --port 8010",
    "dev:web": "npm --prefix frontend run dev",
    "test": "cd backend && ..\\.venv\\Scripts\\python.exe -m pytest -q",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "check": "npm --prefix frontend run check"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
